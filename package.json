{
  "name": "devtool",
  "private": true,
  "version": "1.4.1",
  "description": "Canivete suíço para desenvolvimento — app desktop offline (Tauri + React) com formatadores, encoders, consultas BR, rede e texto.",
  "license": "MIT",
  "author": "Cassiano Mesquita (https://cassianomesquita.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cassianod2/devtool.git"
  },
  "homepage": "https://github.com/cassianod2/devtool#readme",
  "bugs": "https://github.com/cassianod2/devtool/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "check": "npm run typecheck && npm run test",
    "check:versions": "node scripts/check-versions.mjs",
    "set-version": "node scripts/set-version.mjs",
    "release:dry": "npx -y -p semantic-release@24 -p @semantic-release/changelog -p @semantic-release/exec -p @semantic-release/git semantic-release --dry-run --no-ci"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@toast-ui/editor": "^3.2.2",
    "@toast-ui/editor-plugin-code-syntax-highlight": "^3.1.0",
    "@types/prismjs": "^1.26.6",
    "@uiw/react-codemirror": "^4.25.11",
    "bcryptjs": "^3.0.3",
    "cron-parser": "^5.10.0",
    "cronstrue": "^3.24.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "fast-xml-parser": "^5.11.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.38.0",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "prettier": "^3.9.6",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "spark-md5": "^3.0.2",
    "uuid": "^14.0.2",
    "xml-formatter": "^3.7.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
